# Copy to .env and replace placeholders. NEVER commit the real .env.
# Generate a key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-hex-chars-generated-as-above
DATABASE_PATH=instance/vault.db
MAX_UPLOAD_MB=100
KDF_ITERATIONS=600000
# 1 = cookie only sent over HTTPS (production). Set 0 ONLY for plain-http local testing.
SESSION_COOKIE_SECURE=0
HOST=127.0.0.1
PORT=5000
